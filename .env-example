# sample .env file template
# follow the same variable names and structure, replace their values with
# your own credentials.
# to generate your own django secret key, use:
# $ python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# or use the automated bash script provided in the project root directory: generate-env.sh
DJANGO_SECRET_KEY='your-safe-django-secret-key'
# WARNING: insert the ip address of your docker instance.
ALLOWED_HOSTS=localhost
DEBUG_MODE=True